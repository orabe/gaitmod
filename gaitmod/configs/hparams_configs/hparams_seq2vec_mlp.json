{
  "global_settings": {
    "experiment_name": "hparams_seq2seq_LSTM_hctsa_24configs_logRegF1Chs",
    "model_type": "seq2vec_mlp",
    "feature_data": {
      "source": "hctsa",
      "segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-5,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_f1_score",
      "patience": 10
    },
    "decision_threshold_search": {
      "range": [
        0.3,
        0.8
      ],
      "num_sweep_thresholds": 41,
      "metrics": [
        "f1",
        "accuracy",
        "balanced_accuracy",
        "precision",
        "recall"
      ]
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      }
    },
    "selection_metrics": {
      "refit_scoring_metric": "val_f1",
      "selection_score_metric": "val_f1",
      "selection_score_aggregation": "median"
    }
  },
  "feature_params": {
    "feature_selector__enabled": [true],
    "feature_selector__selection_method": [
      "roc_auc"
    ],
    "feature_selector__n_features": [400],
    "feature_selector__variance_threshold": [0.01],
    "feature_selector__correlation_threshold": [0.7]
  },
  "seq2vec_mlp": {
    "feature_params": {
      "scaler__scaler_type": ["standard"]
    },
    "architecture_configs": [
      {
        "classifier__hidden_dims": [64, 96, 64],
        "classifier__activations": ["relu", "relu", "relu"]
      }
    ],
    "other_params": {
      "classifier__dropout": [
        0.2,
        0.5,
        0.8
      ],
      "classifier__dense_units": [1],
      "classifier__dense_activation": ["sigmoid"],
      "classifier__optimizer": ["adam"],
      "classifier__lr": [
        0.001,
        0.0001,
        0.00001,
        0.000001
      ],
      "classifier__patience": [10],
      "classifier__epochs": [100],
      "classifier__batch_size": [
        8,
        16
      ],
      "classifier__threshold": [0.5]
    }
  }
}
