{
  "global_settings": {
    "experiment_name": "Seq2VecMLP_hctsa_betaChs",
    "model_type": "Seq2VecMLP",
    "feature_data": {
      "source": "hctsa",
      "segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_loss",
      "patience": 10
    },
    "decision_threshold_search": {
      "range": [
        0.2,
        0.8
      ],
      "num_sweep_thresholds": 50,
      "metrics": [
        "f1",
        "accuracy",
        "balanced_accuracy",
        "precision",
        "recall"
      ]
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      },
      "channels": null
    },
    "selection_metrics": {
      "selection_score_metric": "val_f1",
      "selection_score_aggregation": "median"
    },
    "global_selection": {
      "inner_aggregation": "median",
      "outer_aggregation": "median",
      "selection_metric": null,
      "subjects": [
        "PW_EM59",
        "PW_FH57",
        "PW_HK59",
        "PW_HZ58",
        "PW_SN61",
        "PW_SN66",
        "PW_US68"
      ],
      "output_path": "logs/hparams_seq2vec_mlp_hctsa_24configs_logRegF1Chs"
    }
  },
  "feature_params": {
    "feature_selector__enabled": [
      true
    ],
    "feature_selector__selection_method": ["roc_auc"],
    "feature_selector__n_features": [20, 50, 100],
    "feature_selector__variance_threshold": [0.0001],
    "feature_selector__correlation_threshold": [0.1, 0.3]
  },
  "Seq2VecMLP": {
    "feature_params": {
      "scaler__scaler_type": ["standard"]
    },
    "architecture_configs": [
      {
        "classifier__hidden_dims": [8],
        "classifier__activations": ["relu"]
      },
      {
        "classifier__hidden_dims": [16],
        "classifier__activations": ["relu"]
      },
      {
        "classifier__hidden_dims": [24],
        "classifier__activations": ["relu"]
      },      
      {
        "classifier__hidden_dims": [16, 8],
        "classifier__activations": ["relu", "relu"]
      }        
    ],
    "other_params": {
      "classifier__dropout": [0.3, 0.5],
      "classifier__dense_units": [1],
      "classifier__dense_activation": ["sigmoid"],
      "classifier__optimizer": ["adam"],
      "classifier__lr": [0.001, 0.0005],
      "classifier__batch_size": [16, 32],
      "classifier__epochs": [120],
      "classifier__patience": [15],
      "classifier__threshold": [0.5]
    }
  }
}
