{
  "global_settings": {
    "experiment_name": "svm_hctsa_betaChs",
    "model_type": "svm",
    "feature_data": {
      "source": "hctsa",
      "segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_loss",
      "patience": 15
    },
    "decision_threshold_search": {
      "range": [0.3, 0.8],
      "num_sweep_thresholds": 10,
      "metrics": ["f1"]
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      },
      "channels": null
    },
    "selection_metrics": {
      "selection_score_metric": "val_f1",
      "selection_score_aggregation": "median"
    },
    "global_selection": {
      "inner_aggregation": "median",
      "outer_aggregation": "median",
      "selection_metric": null,
      "subjects": [
        "PW_EM59",
        "PW_FH57",
        "PW_HK59",
        "PW_HZ58",
        "PW_SN61",
        "PW_SN66",
        "PW_US68"
      ],
      "output_path": "logs/hparams_baselines_hctsa"
    }
  },
  "feature_params": {
    "feature_selector__enabled": [true],
    "feature_selector__selection_method": ["roc_auc"],
    "feature_selector__n_features": [20, 50, 100],
    "feature_selector__variance_threshold": [0.0001],
    "feature_selector__correlation_threshold": [0.1, 0.3]
  },

  "dummy": {
    "param_grid": {
      "classifier__strategy": ["stratified"]
    }
  },  
  "logreg": {
    "param_grid": {
      "classifier__solver": ["lbfgs"],
      "classifier__penalty": ["l2"],
      "classifier__C": [0.003, 0.01, 0.03, 0.1, 0.3, 1.0],
      "classifier__class_weight": [null, "balanced"],
      "classifier__max_iter": [3000],
      "classifier__tol": [0.0001, 0.001],
      "classifier__fit_intercept": [true]
    }
  },
  "svm": {
    "param_grid": {
      "classifier__C": [0.1, 1, 10],
      "classifier__gamma": ["auto"],
      "classifier__kernel": ["rbf", "linear"],
      "classifier__class_weight": [null, "balanced"]
    }
  },
  "rf": {
    "param_grid": {
      "classifier__n_estimators": [100,200],
      "classifier__max_depth": [10, 20],
      "classifier__min_samples_split": [2],
      "classifier__min_samples_leaf": [1, 2],
      "classifier__max_features": ["sqrt", "log2", 0.3, 0.5]
    }
  }, 
  "xgb": {
    "param_grid": {
      "classifier__n_estimators": [100, 200],
      "classifier__max_depth": [3, 6],
      "classifier__learning_rate": [0.01, 0.1]
    }
  }, 
  "lda": {
    "param_grid": {
      "classifier__solver": ["svd", "lsqr"],
      "classifier__shrinkage": [null, "auto"]
    }
  },
  "knn": {
    "param_grid": {
      "classifier__n_neighbors": [3, 5, 7, 11],
      "classifier__weights": ["uniform", "distance"],
      "classifier__metric": ["minkowski"]
    }
  }
}
