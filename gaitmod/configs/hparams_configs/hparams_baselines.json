{
  "global_settings": {
    "experiment_name": "hparams_baselines_hctsa",
    "model_type": "rf",
    "feature_data": {
      "source": "hctsa",
      "segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-5,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "loss",
      "patience": 10
    },
    "decision_threshold_search": {
      "range": [
        0.3,
        0.8
      ],
      "num_sweep_thresholds": 41,
      "metrics": [
        "f1",
        "accuracy",
        "balanced_accuracy",
        "precision",
        "recall"
      ]
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      }
    },
    "selection_metrics": {
      "refit_scoring_metric": "f1",
      "selection_score_metric": "val_tuned_f1",
      "selection_score_aggregation": "median"
    }
  },
  "feature_params": {
    "feature_selector__enabled": [true],
    "feature_selector__selection_method": [
      "roc_auc"
    ],
    "feature_selector__n_features": [400],
    "feature_selector__variance_threshold": [0.01],
    "feature_selector__correlation_threshold": [0.7]
  },
  "rf": {
    "param_grid": {
      "classifier__n_estimators": [100, 200],
      "classifier__max_depth": [10, 20, null],
      "classifier__min_samples_split": [2, 5]
    }
  },
  "svm": {
    "param_grid": {
      "classifier__C": [0.1, 1, 10],
      "classifier__gamma": ["scale", "auto"],
      "classifier__kernel": ["rbf", "linear"]
    }
  },
  "logreg": {
    "param_grid": {
      "classifier__penalty": ["l2"],
      "classifier__C": [0.01, 0.1, 1.0],
      "classifier__solver": ["lbfgs"],
      "classifier__class_weight": [null, "balanced"],
      "classifier__max_iter": [1000]
    }
  },
  "xgb": {
    "param_grid": {
      "classifier__n_estimators": [100, 200],
      "classifier__max_depth": [3, 6],
      "classifier__learning_rate": [0.01, 0.1]
    }
  },
  "dummy": {
    "param_grid": {
      "classifier__strategy": ["most_frequent", "constant"]
    }
  }
}
