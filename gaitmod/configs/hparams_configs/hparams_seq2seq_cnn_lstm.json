{
  "global_settings": {
    "experiment_name": "Seq2SeqCNNLSTM_raw_betaChs_NO_FC_originalSegments",
    "model_type": "Seq2SeqCNNLSTM",
    "feature_data": {
      "source": "raw",
      "segment_cache_dir": "data/raw_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_loss",
      "patience": 15
    },
    "decision_threshold_search": {
      "range": [
        0.3,
        0.8
      ],
      "num_sweep_thresholds": 10,
      "metrics": ["f1"]
    },
    "stateful_testing": {
      "use_stateful_mode": true,
      "reset_between_trials": true,
      "description": "Stateful mode for CNN-LSTM: Enables sequential processing where CNN extracts features per epoch and LSTM maintains state across epochs. When true: (1) StatefulValidationCallback added during training, (2) Early stopping monitors stateful_val_loss (deployment-realistic), (3) Test uses epoch-by-epoch prediction. Simulates real-time DBS with raw LFP signals arriving epoch-by-epoch. Performance: ~2-3x slower validation, ~38x slower test. Use for deployment validation, not routine experiments."
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      },
      "channels": null
    },
    "selection_metrics": {
      "selection_score_metric": "val_roc_auc",
      "selection_score_aggregation": "median"
    },
    "global_selection": {
      "inner_aggregation": "median",
      "outer_aggregation": "median"
    }
  },
  "feature_params": {
    "feature_selector__variance_threshold": [0.01],
    "feature_selector__enabled": [false],
    "feature_selector__n_features": [300],
    "feature_selector__selection_method": ["roc_auc"],
    "feature_selector__correlation_threshold": [0.3]
  },
  "Seq2SeqCNNLSTM": {
    "feature_params": {
      "scaler__scaler_type": ["standard"]
    },
    "architecture_configs": [
      {
        "classifier__cnn_filters": [8],
        "classifier__cnn_kernel_sizes": [7],
        "classifier__cnn_activations": ["relu"],
        "classifier__cnn_pool_sizes": [2],
        "classifier__cnn_use_global_pooling": true,
        "classifier__hidden_dims": [8],
        "classifier__activations": ["tanh"],
        "classifier__recurrent_activations": ["sigmoid"],
        "classifier__use_class_weights": true,
        "classifier__threshold": 0.5,
        "classifier__head_dense_units": null,
        "classifier__head_dense_activation": "relu"

      }
    ],
    "other_params": {
      "classifier__dropout": [0.5],
      "classifier__dense_units": [1],
      "classifier__dense_activation": ["sigmoid"],
      "classifier__optimizer": ["adam"],
      "classifier__lr": [0.0005],
      "classifier__batch_size": [4],
      "classifier__epochs": [120],
      "classifier__patience": [15]
    }
  }
}
