{
  "global_settings": {
    "experiment_name": "Seq2VecMLPLSTM_betaChs",
    "model_type": "Seq2VecMLPLSTM",
    "feature_data": {
      "source": "mlp_lstm",
      "raw_source": "raw",
      "raw_segment_cache_dir": "data/raw_segments",
      "hctsa_source": "hctsa",
      "hctsa_segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_lstm_head_weighted_sum_f1_score",
      "patience": 10
    },
    "decision_threshold_search": {
      "range": [0.3, 0.8],
      "num_sweep_thresholds": 3,
      "metrics": ["f1"]
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      },
      "channels": null
    },
    "selection_metrics": {
      "refit_scoring_metric": "val_f1",
      "selection_score_metric": "val_f1",
      "selection_score_aggregation": "median"
    }
  },
  "feature_params": {
    "feature_selector__variance_threshold": [0.01],
    "feature_selector__enabled": [false],
    "feature_selector__n_features": [100],
    "feature_selector__selection_method": ["roc_auc"],
    "feature_selector__correlation_threshold": [0.7]
  },
  "Seq2VecMLPLSTM": {
    "feature_params": {
      "scaler__scaler_type": ["standard"]
    },
    "architecture_configs": [
      {
        "classifier__mlp_hidden_units": [100],
        "classifier__mlp_activation": "relu",
        "classifier__mlp_dense_activation": "sigmoid",

        "classifier__lstm_hidden_dims": [128, 128],
        "classifier__lstm_activations": ["tanh", "tanh"],
        "classifier__lstm_recurrent_activations": ["sigmoid", "sigmoid"],
        "classifier__lstm_dense_units": 1,
        "classifier__lstm_dense_activation": "sigmoid",
        "classifier__lstm_head_weights": [0.5, 0.5]
      },
    {
        "classifier__mlp_hidden_units": [100],
        "classifier__mlp_activation": "relu",
        "classifier__mlp_dense_activation": "sigmoid",

        "classifier__lstm_hidden_dims": [64, 64],
        "classifier__lstm_activations": ["tanh", "tanh"],
        "classifier__lstm_recurrent_activations": ["sigmoid", "sigmoid"],
        "classifier__lstm_dense_units": 1,
        "classifier__lstm_dense_activation": "sigmoid",
        "classifier__lstm_head_weights": [0.5, 0.5]
      }
    ],
    "other_params": {
      "classifier__mlp_optimizer": ["adam"],
      "classifier__mlp_lr": [0.001],
      "classifier__mlp_epochs": [50],
      "classifier__mlp_batch_size": [32],
      "classifier__mlp_use_class_weights": [true],
      "classifier__mlp_dropout": [0.5],

      "classifier__lstm_optimizer": ["adam"],
      "classifier__lstm_lr": [0.001, 0.0001],
      "classifier__lstm_epochs": [100],
      "classifier__lstm_batch_size": [16],
      "classifier__lstm_patience": [10],
      "classifier__lstm_threshold": [0.5],
      "classifier__lstm_use_class_weights": [true],
      "classifier__lstm_dropout": [0.2],

      "classifier__hctsa_fs_enabled": [true],
      "classifier__hctsa_fs_n_features": [50],
      "classifier__hctsa_fs_variance_threshold": [0.01],
      "classifier__hctsa_fs_correlation_threshold": [0.7],
      "classifier__hctsa_fs_selection_method": ["roc_auc"],
      
      "classifier__alpha": [0.5],
      "classifier__fusion_weight": [0.5]
    }
  }
}
