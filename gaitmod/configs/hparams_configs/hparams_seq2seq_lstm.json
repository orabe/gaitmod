{
  "global_settings": {
    "experiment_name": "Seq2SeqLSTM_hctsa_betaChs_stateful",
    "model_type": "Seq2SeqLSTM",
    "feature_data": {
      "source": "hctsa",
      "segment_cache_dir": "data/hctsa_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
      "reduce_lr_patience_ratio": 0.3,
      "monitor": "val_loss",
      "patience": 10
    },
    "decision_threshold_search": {
      "range": [
        0.3,
        0.8
      ],
      "num_sweep_thresholds": 1,
      "metrics": [
        "f1"
      ]
    },
    "stateful_testing": {
      "use_stateful_mode": true,
      "reset_between_trials": true,
      "description": "Stateful mode enables epoch-by-epoch processing for deployment simulation. When true: (1) Validation uses stateful LSTM during training (early stopping monitors stateful_val_loss), (2) Test evaluation uses epoch-by-epoch prediction, (3) Hyperparameters selected based on deployment conditions. When false (default): Standard batch processing for training, validation, and test. Use stateful_mode=true for DBS deployment validation, false for faster experimentation."
    },
    "masking": {
      "global_x_mask_value": 1000000.0,
      "y_mask_value": -1
    },
    "channel_selection": {
      "default_method": "beta",
      "methods": {
        "beta": {
          "PW_EM59": "channel_2-LFP_L0-2",
          "PW_FH57": "channel_2-LFP_L0-2",
          "PW_HK59": "channel_2-LFP_L0-2",
          "PW_HZ58": "channel_2-LFP_L0-2",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_5-LFP_R0-2",
          "PW_US68": "channel_1-LFP_L1-3"
        },
        "logRegF1": {
          "PW_EM59": "channel_0-LFP_L0-3",
          "PW_FH57": "channel_1-LFP_L1-3",
          "PW_HK59": "channel_0-LFP_L0-3",
          "PW_HZ58": "channel_1-LFP_L1-3",
          "PW_SN61": "channel_2-LFP_L0-2",
          "PW_SN66": "channel_0-LFP_L0-3",
          "PW_US68": "channel_4-LFP_R1-3"
        }
      },
      "channels": null
    },
    "selection_metrics": {
      "selection_score_metric": "val_roc_auc",
      "selection_score_aggregation": "median"
    },
    "global_selection": {
      "inner_aggregation": "median",
      "outer_aggregation": "median",
      "selection_metric": null,
      "subjects": [
        "PW_EM59",
        "PW_FH57",
        "PW_HK59",
        "PW_HZ58",
        "PW_SN61",
        "PW_SN66",
        "PW_US68"
      ],
      "output_path": "logs/hparams_seq2seq_LSTM_hctsa"
    }
  },
  "feature_params": {
    "feature_selector__variance_threshold": [
      0.01
    ],
    "feature_selector__enabled": [
      true
    ],
    "feature_selector__n_features": [
      300
    ],
    "feature_selector__selection_method": [
      "roc_auc"
    ],
    "feature_selector__correlation_threshold": [
      0.3
    ]
  },
  "Seq2SeqLSTM": {
    "feature_params": {
      "scaler__scaler_type": ["standard"]
    },
    "architecture_configs": [
      {
        "classifier__hidden_dims": [32],
        "classifier__activations": ["tanh"],
        "classifier__recurrent_activations": ["sigmoid"],
        "classifier__dropout": 0.5,
        "classifier__lr": 0.001,
        "classifier__batch_size": 16,
        "classifier__epochs": 60,
        "classifier__patience": 10,
        "classifier__dense_units": 1,
        "classifier__dense_activation": "sigmoid",
        "classifier__optimizer": "adam",
        "classifier__threshold": 0.5,
        "classifier__use_class_weights": true
      },
      {
        "classifier__hidden_dims": [64],
        "classifier__activations": ["tanh"],
        "classifier__recurrent_activations": ["sigmoid"],
        "classifier__dropout": 0.4,
        "classifier__lr": 0.001,
        "classifier__batch_size": 32,
        "classifier__epochs": 60,
        "classifier__patience": 10,
        "classifier__dense_units": 1,
        "classifier__dense_activation": "sigmoid",
        "classifier__optimizer": "adam",
        "classifier__threshold": 0.5,
        "classifier__use_class_weights": true
      }
    ],
    "other_params": {
    }
  }
}