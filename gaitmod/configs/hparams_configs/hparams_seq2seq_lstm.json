{
  "global_settings": {
    "experiment_name": "Seq2SeqLSTM_raw_allChs",
    "model_type": "Seq2SeqLSTM",
    "feature_data": {
      "source": "raw",
      "segment_cache_dir": "data/raw_segments"
    },
    "callbacks": {
      "progress_frequency": 1,
      "reduce_lr_factor": 0.5,
      "reduce_lr_min_lr": 1e-05,
